# Platform sync integrations UI (Meta/Google/LinkedIn/Shopify connect flows).
# Must be kept in sync with the backend's ENABLE_PLATFORM_SYNC -- this only
# controls whether the frontend shows the nav link / connect UI; the backend
# independently rejects integration requests when its own flag is off, so
# turning this on alone does not make platform sync functional.
# Leave unset/false (default) until platform_connections has been migrated
# in production and ENABLE_PLATFORM_SYNC is also enabled on the backend.
REACT_APP_ENABLE_PLATFORM_SYNC=false
