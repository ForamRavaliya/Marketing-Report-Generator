PORT=5000
NODE_ENV=development

# Platform sync integrations (Meta/Google/LinkedIn/Shopify OAuth + auto-sync).
# Leave unset/false until the platform_connections migration has been run
# against production AND provider OAuth credentials are configured below.
# When false (default), routes/integrations.js rejects all requests with a
# 503 and the auto-sync cron job does not start.
ENABLE_PLATFORM_SYNC=false

# Monthly scheduled email reports. Leave unset/false until email delivery
# has been reviewed and approved for production use.
ENABLE_EMAIL_SCHEDULER=false

# PostgreSQL
DB_HOST=ep-damp-violet-am5zph5z.c-5.us-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=1234

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
